# URL base de la API (Fastify)
BACKEND_URL=http://localhost:3000
# Misma API_KEY que la API; solo se usa en el servidor, nunca llega al navegador
API_KEY=your-secret-api-key-here
# Contraseña de acceso a la web
APP_PASSWORD=your-app-password
# Secreto para firmar el JWT de sesión (cadena larga y aleatoria)
SESSION_SECRET=a-long-random-string

# Opcional — habilita el botón "Clasificar pendientes"
GEMINI_API_KEY=
# Opcional — pistas en texto libre para la clasificación (apodos, sitios
# habituales, gastos compartidos...). Se inyectan en el prompt tal cual.
# Ejemplo: - "Ana" es la pareja del usuario; sus gastos van en "mi amor".
CLASSIFY_CONTEXT=
